<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnButtonTakePhoto"
            android:layout_width="199dp"
            android:layout_height="100dp"
            android:layout_marginEnd="5dp"
            android:text="@string/button_take_photo"
            android:textAllCaps="true"
            android:textSize="25sp"
            app:layout_constraintBottom_toTopOf="@+id/btnButtonList"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnButtonSelectPhoto"
            android:layout_width="200dp"
            android:layout_height="100dp"
            android:layout_marginStart="5dp"
            android:text="@string/button_select_photo"
            android:textAllCaps="true"
            android:textSize="25sp"
            app:layout_constraintBottom_toTopOf="@+id/btnButtonList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/btnButtonList"
            android:layout_width="300dp"
            android:layout_height="120dp"
            android:layout_margin="30dp"
            android:text="@string/button_list"
            android:textAllCaps="true"
            android:textSize="25sp"
            app:layout_constraintBottom_toTopOf="@+id/btnButtonWeather"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnButtonWeather"
            android:layout_width="300dp"
            android:layout_height="120dp"
            android:layout_marginBottom="250dp"
            android:text="@string/button_weather"
            android:textAllCaps="true"
            android:textSize="25sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/imageId"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnButtonWeather" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>